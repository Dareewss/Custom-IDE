{
  "name": "code-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.desktop.json --noEmit",
    "test": "vitest run && python scripts/test-serializer.py",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "predev": "node scripts/prepare-runtime.mjs",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:compile": "node scripts/compile-desktop.mjs",
    "desktop": "npm run build && npm run desktop:compile && node scripts/start-desktop.mjs",
    "desktop:package": "npm run build && npm run desktop:compile && node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "desktop:shortcut": "powershell -NoProfile -File scripts/create-desktop-shortcut.ps1"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "^0.17.3",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "cmdk": "^1.1.1",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.65.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.9.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.2",
    "tailwindcss": "^4.3.3",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.27.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
